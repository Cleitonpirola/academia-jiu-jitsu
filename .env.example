# Sem DATABASE_URL, o MVP usa SQLite local em data/academia.sqlite.
PORT=3333
HOST=127.0.0.1
# Deixe vazio no desenvolvimento. Antes de publicar, configure o administrador localmente.
# Em hospedagem, informe a origem HTTPS exata, sem barra final, para cookie Secure e verificação de origem.
APP_ORIGIN=
# Temporário: true permite o administrador já cadastrado entrar sem senha só neste computador.
# Ignorado com APP_ORIGIN, NODE_ENV=production, HOST aberto ou requisição encaminhada por proxy.
# Para voltar ao login normal, deixe false e reinicie a API.
TATAME_ADMIN_LOCAL=false
DATABASE_URL=
DIRECT_URL=
SQLITE_PATH=data/academia.sqlite
ANALYTICS_URL=http://127.0.0.1:8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Seeds automáticos somente no banco local. Para Supabase: npm run db:seed.
SEED_LOCAL=true
