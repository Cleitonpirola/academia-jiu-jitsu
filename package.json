{
  "name": "tatame-academia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs",
    "start": "node scripts/run.mjs --production",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "tsx --test apps/api/src/app.test.ts",
    "setup:analytics": "node scripts/setup-python.mjs",
    "test:analytics": "node scripts/test-python.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx apps/api/src/seed-command.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tatame/shared": "*",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.577.0",
    "openai": "^6.0.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.1.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prisma": "^7.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
