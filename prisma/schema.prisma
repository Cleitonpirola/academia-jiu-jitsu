generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model Aluno {
  id             String       @id @default(uuid()) @db.Uuid
  nome           String
  telefone       String
  email          String       @unique
  dataNascimento String       @db.VarChar(10)
  faixa          String
  dataMatricula  String       @db.VarChar(10)
  situacao       String       @default("ativo")
  criadoEm       String
  mensalidades   Mensalidade[]
  presencas      Presenca[]
  turmas         AlunoTurma[]
  aulasPrevistas AulaAlunoPrevisto[]
  chamadas       PresencaAula[]
  usuario        Usuario?
  checkins       CheckinAula[]
}
model Mensalidade {
  id             String @id @default(uuid()) @db.Uuid
  alunoId        String @db.Uuid
  aluno          Aluno  @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  competencia    String @db.VarChar(7)
  valorCentavos  Int
  dataVencimento String @db.VarChar(10)
  dataPagamento  String? @db.VarChar(10)
  criadoEm       String
  @@unique([alunoId, competencia])
  @@index([dataVencimento])
}
model Presenca {
  id         String  @id @default(uuid()) @db.Uuid
  alunoId    String  @db.Uuid
  aluno      Aluno   @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  dataTreino String  @db.VarChar(10)
  tipoTreino String
  presente   Boolean
  @@unique([alunoId, dataTreino, tipoTreino])
}
model Analise {
  id       String @id @default(uuid()) @db.Uuid
  pergunta String
  resposta String
  modelo   String
  usuario  String
  metricas String
  criadoEm String
}
model Turma {
  id           String @id @default(uuid()) @db.Uuid
  nome         String
  professor    String
  situacao     String
  criadoEm     String
  atualizadoEm String
  horarios     HorarioTurma[]
  alunos       AlunoTurma[]
  aulas        Aula[]
}
model HorarioTurma {
  id         String @id @default(uuid()) @db.Uuid
  turmaId    String @db.Uuid
  turma      Turma @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  diaSemana  Int
  horaInicio String @db.VarChar(5)
  horaFim    String @db.VarChar(5)
  @@unique([turmaId, diaSemana, horaInicio])
}
model AlunoTurma {
  id       String @id @default(uuid()) @db.Uuid
  turmaId  String @db.Uuid
  turma    Turma @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  alunoId  String @db.Uuid
  aluno    Aluno @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  criadoEm String
  @@unique([turmaId, alunoId])
  @@index([alunoId])
}
model Aula {
  id                 String @id @default(uuid()) @db.Uuid
  titulo             String
  dataAula           String
  horaInicio         String @db.VarChar(5)
  horaFim            String @db.VarChar(5)
  professor          String
  origem             String
  origemHorarioId    String? @db.Uuid
  turmaId            String? @db.Uuid
  turma              Turma? @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  turmaNome          String?
  situacao           String
  motivoCancelamento String?
  canceladaEm        String?
  criadoEm           String
  alunosPrevistos    AulaAlunoPrevisto[]
  chamada            PresencaAula[]
  checkins           CheckinAula[]
  @@unique([origemHorarioId, dataAula])
  @@index([dataAula])
  @@index([turmaId])
}
model AulaAlunoPrevisto {
  id      String @id @default(uuid()) @db.Uuid
  aulaId  String @db.Uuid
  aula    Aula @relation(fields: [aulaId], references: [id], onDelete: Restrict)
  alunoId String? @db.Uuid
  aluno   Aluno? @relation(fields: [alunoId], references: [id], onDelete: SetNull)
  nome    String
  @@unique([aulaId, alunoId])
  @@index([alunoId])
}

model PresencaAula {
  id           String @id @default(uuid()) @db.Uuid
  aulaId       String @db.Uuid
  aula         Aula @relation(fields: [aulaId], references: [id], onDelete: Restrict)
  alunoId      String @db.Uuid
  aluno        Aluno @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  nome         String
  presente     Boolean
  criadoEm     String
  atualizadoEm String
  @@unique([aulaId, alunoId])
  @@index([alunoId])
}

model Usuario {
  id String @id @default(uuid()) @db.Uuid
  nome String
  email String @unique
  perfil String
  alunoId String? @unique @db.Uuid
  aluno Aluno? @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  senhaHash String?
  conviteHash String? @unique
  conviteExpiraEm String?
  criadoEm String
  sessoes Sessao[]
}
model Sessao {
  id String @id @default(uuid()) @db.Uuid
  usuarioId String @db.Uuid
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  credencialHash String
  expiraEm String
  criadoEm String
  @@index([usuarioId])
}
model CheckinAula {
  id String @id @default(uuid()) @db.Uuid
  aulaId String @db.Uuid
  aula Aula @relation(fields: [aulaId], references: [id], onDelete: Restrict)
  alunoId String @db.Uuid
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  nome String
  criadoEm String
  @@unique([aulaId, alunoId])
  @@index([alunoId])
}
