generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model Aluno {
  id             String       @id @default(uuid()) @db.Uuid
  nome           String
  telefone       String
  email          String       @unique
  dataNascimento String       @db.VarChar(10)
  faixa          String
  faixaId String? @db.Uuid
  faixaCadastro FaixaGraduacao? @relation(fields: [faixaId], references: [id], onDelete: Restrict)
  grauId String? @db.Uuid
  grau GrauFaixa? @relation(fields: [faixaId,grauId], references: [faixaId,id], onDelete: Restrict)
  dataMatricula  String       @db.VarChar(10)
  situacao       String       @default("ativo")
  criadoEm       String
  limiteAulasMensal Int?
  aulasRestantesMes Int?
  mesSaldoAulas String? @db.VarChar(7)
  possuiCelular Boolean @default(true)
  acessoPrincipal String @default("aluno")
  responsabilidadeTransferidaEm String?
  responsaveis ResponsavelAluno[]
  eventosAcesso EventoAcessoAluno[]
  comunicados ComunicadoAluno[]
  mensalidades   Mensalidade[]
  presencas      Presenca[]
  turmas         AlunoTurma[]
  aulasPrevistas AulaAlunoPrevisto[]
  chamadas       PresencaAula[]
  usuario        Usuario?
  checkins       CheckinAula[]
  plano          PlanoAluno?
  liberacoes     LiberacaoAula[]
  debitos        DebitoAula[]
}
model FaixaGraduacao {
  id String @id @default(uuid()) @db.Uuid
  nome String @unique
  chave String @unique
  cor String
  ordem Int
  situacao String
  criadoEm String
  atualizadoEm String
  graus GrauFaixa[]
  alunos Aluno[]
}
model GrauFaixa {
  id String @id @default(uuid()) @db.Uuid
  faixaId String @db.Uuid
  faixa FaixaGraduacao @relation(fields: [faixaId], references: [id], onDelete: Restrict)
  numero Int
  situacao String
  criadoEm String
  atualizadoEm String
  alunos Aluno[]
  @@unique([faixaId,numero])
  @@unique([faixaId,id])
}
model Mensalidade {
  id             String @id @default(uuid()) @db.Uuid
  alunoId        String @db.Uuid
  aluno          Aluno  @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  competencia    String @db.VarChar(7)
  valorCentavos  Int
  dataVencimento String @db.VarChar(10)
  dataPagamento  String? @db.VarChar(10)
  criadoEm       String
  @@unique([alunoId, competencia])
  @@index([dataVencimento])
}
model Presenca {
  id         String  @id @default(uuid()) @db.Uuid
  alunoId    String  @db.Uuid
  aluno      Aluno   @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  dataTreino String  @db.VarChar(10)
  tipoTreino String
  presente   Boolean
  @@unique([alunoId, dataTreino, tipoTreino])
}
model Analise {
  id       String @id @default(uuid()) @db.Uuid
  pergunta String
  resposta String
  modelo   String
  usuario  String
  metricas String
  criadoEm String
}
model Turma {
  id           String @id @default(uuid()) @db.Uuid
  nome         String
  professor    String
  situacao     String
  criadoEm     String
  atualizadoEm String
  horarios     HorarioTurma[]
  alunos       AlunoTurma[]
  aulas        Aula[]
}
model HorarioTurma {
  id         String @id @default(uuid()) @db.Uuid
  turmaId    String @db.Uuid
  turma      Turma @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  diaSemana  Int
  horaInicio String @db.VarChar(5)
  horaFim    String @db.VarChar(5)
  @@unique([turmaId, diaSemana, horaInicio])
}
model AlunoTurma {
  id       String @id @default(uuid()) @db.Uuid
  turmaId  String @db.Uuid
  turma    Turma @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  alunoId  String @db.Uuid
  aluno    Aluno @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  criadoEm String
  @@unique([turmaId, alunoId])
  @@index([alunoId])
}
model Aula {
  id                 String @id @default(uuid()) @db.Uuid
  titulo             String
  dataAula           String
  horaInicio         String @db.VarChar(5)
  horaFim            String @db.VarChar(5)
  professor          String
  origem             String
  origemHorarioId    String? @db.Uuid
  turmaId            String? @db.Uuid
  turma              Turma? @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  turmaNome          String?
  situacao           String
  motivoCancelamento String?
  canceladaEm        String?
  criadoEm           String
  alunosPrevistos    AulaAlunoPrevisto[]
  chamada            PresencaAula[]
  checkins           CheckinAula[]
  liberacoes         LiberacaoAula[]
  debitos            DebitoAula[]
  @@unique([origemHorarioId, dataAula])
  @@index([dataAula])
  @@index([turmaId])
}
model AulaAlunoPrevisto {
  id      String @id @default(uuid()) @db.Uuid
  aulaId  String @db.Uuid
  aula    Aula @relation(fields: [aulaId], references: [id], onDelete: Restrict)
  alunoId String? @db.Uuid
  aluno   Aluno? @relation(fields: [alunoId], references: [id], onDelete: SetNull)
  nome    String
  @@unique([aulaId, alunoId])
  @@index([alunoId])
}

model PresencaAula {
  id           String @id @default(uuid()) @db.Uuid
  aulaId       String @db.Uuid
  aula         Aula @relation(fields: [aulaId], references: [id], onDelete: Restrict)
  alunoId      String @db.Uuid
  aluno        Aluno @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  nome         String
  presente     Boolean
  criadoEm     String
  atualizadoEm String
  @@unique([aulaId, alunoId])
  @@index([alunoId])
}

model Usuario {
  id String @id @default(uuid()) @db.Uuid
  nome String
  email String @unique
  perfil String
  alunoId String? @unique @db.Uuid
  aluno Aluno? @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  senhaHash String?
  conviteHash String? @unique
  conviteExpiraEm String?
  criadoEm String
  sessoes Sessao[]
  liberacoes LiberacaoAula[]
  baixasDebitos DebitoAula[]
  configuracoes ConfiguracaoAcademia[]
  dependentes ResponsavelAluno[]
  eventosAcesso EventoAcessoAluno[]
  comunicadosRecebidos ComunicadoAluno[] @relation("destinatario")
  comunicadosEnviados ComunicadoAluno[] @relation("autor")
}
model ResponsavelAluno {
  id String @id @default(uuid()) @db.Uuid
  alunoId String @db.Uuid
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  usuarioId String @db.Uuid
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  telefone String
  parentesco String
  tipoVinculo String
  criadoEm String
  atualizadoEm String
  @@unique([alunoId, usuarioId])
}
model EventoAcessoAluno {
  id String @id @default(uuid()) @db.Uuid
  alunoId String @db.Uuid
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  usuarioId String @db.Uuid
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  tipo String
  detalhes String
  criadoEm String
}
model ComunicadoAluno {
  id String @id @default(uuid()) @db.Uuid
  alunoId String @db.Uuid
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  destinatarioId String @db.Uuid
  destinatario Usuario @relation("destinatario", fields: [destinatarioId], references: [id], onDelete: Restrict)
  autorId String @db.Uuid
  autor Usuario @relation("autor", fields: [autorId], references: [id], onDelete: Restrict)
  tipo String
  titulo String
  mensagem String
  resposta String?
  respondidoEm String?
  criadoEm String
}
model Sessao {
  id String @id @default(uuid()) @db.Uuid
  usuarioId String @db.Uuid
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  credencialHash String
  expiraEm String
  criadoEm String
  @@index([usuarioId])
}
model CheckinAula {
  id String @id @default(uuid()) @db.Uuid
  aulaId String @db.Uuid
  aula Aula @relation(fields: [aulaId], references: [id], onDelete: Restrict)
  alunoId String @db.Uuid
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  nome String
  criadoEm String
  @@unique([aulaId, alunoId])
  @@index([alunoId])
}

model PlanoAluno {
  id String @id @default(uuid()) @db.Uuid
  alunoId String @unique @db.Uuid
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  nome String
  limiteSemanal Int?
  criadoEm String
  atualizadoEm String
}
model LiberacaoAula {
  id String @id @default(uuid()) @db.Uuid
  aulaId String @db.Uuid
  aula Aula @relation(fields: [aulaId], references: [id], onDelete: Restrict)
  alunoId String @db.Uuid
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  motivo String
  usuarioId String @db.Uuid
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  criadoEm String
  @@unique([aulaId, alunoId])
  @@index([alunoId])
}

model ConfiguracaoAcademia {
  id String @id
  valorAulaAdicionalCentavos Int?
  prazoPagamentoDias Int @default(3)
  atualizadoEm String
  atualizadoPorId String @db.Uuid
  atualizadoPor Usuario @relation(fields: [atualizadoPorId], references: [id], onDelete: Restrict)
}
model DebitoAula {
  id String @id @default(uuid()) @db.Uuid
  alunoId String @db.Uuid
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  aulaId String @db.Uuid
  aula Aula @relation(fields: [aulaId], references: [id], onDelete: Restrict)
  motivo String
  aulaTitulo String
  dataAula String
  horaInicio String
  valorCentavos Int
  prazoPagamentoDias Int
  criadoEm String
  dataVencimento String
  statusPagamento String
  dataPagamento String?
  baixadoPorId String? @db.Uuid
  baixadoPor Usuario? @relation(fields: [baixadoPorId], references: [id], onDelete: Restrict)
  canceladoEm String?
  motivoCancelamento String?
  @@unique([alunoId, aulaId])
  @@index([alunoId, dataVencimento])
}
